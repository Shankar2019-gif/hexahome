# ==============================================================================
# HexaHome Environment Configuration Template
# All secrets must be supplied via environment variables. NEVER commit .env!
# ==============================================================================

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL with PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hexahome_db
POSTGRES_USER=hexahome_user
POSTGRES_PASSWORD=your_secure_postgres_password
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis (OTP & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# JWT Security
JWT_SECRET=your_base64_encoded_256bit_minimum_jwt_secret_key_here
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# Admin Initial Bootstrap Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@HexaHome2025
ADMIN_EMAIL=admin@hexahome.in

# CORS Configuration
CORS_ALLOWED_ORIGIN=http://localhost:8085

# AWS S3 & CloudFront (Media Storage)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=hexahome-media-storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
CLOUDFRONT_DOMAIN=https://img.hexahome.in


# Google Maps API (Frontend)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key
