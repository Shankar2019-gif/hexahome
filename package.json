{
  "name": "hexahome-project",
  "version": "1.0.0",
  "private": true,
  "description": "HexaHome Fullstack Real Estate Platform (Frontend & Backend)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:preview": "npm --prefix frontend run preview",
    "backend:build": "cd backend && mvn clean package -DskipTests",
    "backend:test": "cd backend && mvn test",
    "gateway:build": "cd gateway && mvn clean package -DskipTests",
    "gateway:test": "cd gateway && mvn test",
    "gateway:dev": "cd gateway && mvn spring-boot:run",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
